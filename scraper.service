[Unit]
Description=24/7 Flutter Job Scraper & Discord Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Linkdin_Scraper
ExecStart=/home/ubuntu/Linkdin_Scraper/.venv/bin/python main.py
Restart=always
RestartSec=15
StandardOutput=append:/home/ubuntu/Linkdin_Scraper/scraper.log
StandardError=append:/home/ubuntu/Linkdin_Scraper/scraper_err.log

[Install]
WantedBy=multi-user.target
